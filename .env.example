# --- Supabase (database of processed episodes) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# --- Groq (free Whisper STT + free LLM) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_STT_MODEL=whisper-large-v3-turbo
# Qwen handles Chinese source transcripts (both podcast sources are Chinese)
# far more reliably than Llama, which frequently answered in Chinese instead
# of translating to Persian. See summarizer.py for why reasoning_effort matters.
GROQ_LLM_MODEL=qwen/qwen3.6-27b

# --- Telegram ---
# Create a bot with @BotFather, add it as admin to your channel
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=@your_channel_username_or_-100xxxxxxxxxx

# --- Sources ---
CROSSINGPODCAST_API=https://crossingpodcast.com/api/trpc/episodes.list
SV101_RSS_URL=https://feeds.fireside.fm/sv101/rss

# --- Behavior ---
# How many minutes between each check when running in --loop mode
CHECK_INTERVAL_MINUTES=60
# Max episodes to backfill/process per run (safety cap)
MAX_EPISODES_PER_RUN=3
# Minimum minutes between two phase-2 (backlog) episodes actually getting
# processed, regardless of how often main.py itself is invoked -- keeps
# Groq's daily token cap safe even if the GitHub Actions schedule (which
# fires 4x/hour as a safety net) ends up firing more than once per hour.
# 75 min -> ~18-19 real episodes/day, safely under the ~19-episode budget
# implied by Groq's 200k-tokens/day cap at ~10-11k tokens/episode.
MIN_BACKLOG_INTERVAL_MINUTES=75
# Working directory for temporary audio downloads
TEMP_DIR=./tmp_audio

# --- yt_relay add-on (YouTube -> Telegram relay, standalone feature) ---
# Self-contained: reuses SUPABASE_URL/SUPABASE_KEY/GROQ_API_KEY/
# TELEGRAM_BOT_TOKEN above, plus its own channel and its own tables
# (yt_channels/yt_queue -- see yt_relay_schema.sql). See CLAUDE.md for the
# full architecture and yt_relay/ for the code. Removable without touching
# anything above this line.
YT_TELEGRAM_CHANNEL_ID=@your_yt_relay_channel_or_-100xxxxxxxxxx
YT_RELAY_ENABLED=true
# Keep true until you've reviewed a week of rendered_text output in the
# 'ready'/'posted' rows -- see CLAUDE.md milestone M4.
YT_RELAY_DRY_RUN=true
# Videos older than this (by published_at) are never queued as 'pending',
# and a 'ready' row still older than this at publish time is skipped as
# stale instead of posted (see CLAUDE.md section 5.5, guard a).
MAX_AGE_HOURS=48
# Hard daily cap, counted from 'posted' rows since local midnight UTC.
MAX_POSTS_PER_DAY=8
# Enforced in code (publish.py), not by the cron schedule -- see CLAUDE.md
# section 7 for why the schedule alone can't be trusted for this.
MIN_HOURS_BETWEEN_POSTS=3
# Max pending rows captioned (1 Groq call each) per discover run.
YT_MAX_CAPTIONS_PER_RUN=3
# Backpressure on the caption step: if the 'ready' queue already has this
# many rows, discover.py skips captioning this run rather than caption
# videos that will likely go stale before they're ever posted (see
# CLAUDE.md section 5.5, guard d). Sized for a 10-30 channel list.
YT_READY_QUEUE_MAX=8
# preview = clickable video thumbnail via Telegram's own link preview (shows
# a "YouTube" card with the video's own English title/description above the
# thumbnail -- confirmed via a live test post); photo = just the YouTube
# thumbnail uploaded as a photo with the Persian caption below it, no English
# text, not clickable-to-play. Decided in milestone M3 by comparing both
# with a real post -- see CLAUDE.md section 5.1. photo was chosen here to
# keep the channel fully Persian.
YT_POST_STYLE=photo
